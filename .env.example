# 复制为 .env 后填写真实值。切勿把填好的 .env 提交到 Git。
# 如果 Node.js 运行在 Docker 宿主机同一台电脑上：
#DB_HOST=127.0.0.1
# 如果 Node.js 运行在局域网内另一台 Windows 上，填运行 Docker 的宿主机 IP：
DB_HOST=192.168.x.x

DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=romm

PORT=3000
# ===== RomM 封面 =====
# RomM Web 地址(不带末尾斜杠),用于拼接本地封面 URL
ROMM_URL=http://192.168.x.x:7676

# ===== 翻译服务(可选)=====
# OpenAI 兼容接口;不填则后端走演示模式(仅加 [译] 前缀)
# DeepSeek 示例:
#TRANSLATE_API_URL=https://api.deepseek.com/v1
#TRANSLATE_API_KEY=sk-xxxxxxxx
#TRANSLATE_MODEL=deepseek-chat
TRANSLATE_API_URL=
TRANSLATE_API_KEY=
TRANSLATE_MODEL=

# ===== RomM 账号(修改封面/上传封面时使用)=====
ROMM_USER=
ROMM_PASSWORD=

# ===== IGDB 封面搜索(可选)=====
# 注册地址: https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
